# Platform
CONFIG_MACH_XIAOMI_MUNCH=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH_3658U=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_SUPPORT_NEW_GAME_MODE=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC=y
CONFIG_FINGERPRINT_GOODIX=y

# Power
CONFIG_QPNP_SMB5=n
CONFIG_QPNP_SMB5_MUNCH=y
CONFIG_BQ2597X_CHARGE_PUMP_STANDALONE_MUNCH=y
CONFIG_CHARGER_LN8000_MUNCH=y
CONFIG_FUEL_GAUGE_BQ27Z561_MUNCH=y

# Ultrasound Proximity
CONFIG_US_PROXIMITY=y

# Vibrator（munch 的 dts 匹配串是 awinic,awinic_haptic —— 只有 aw86927 驱动认这个串）
CONFIG_INPUT_AW86927_HAPTIC=y
# CONFIG_INPUT_AW8697_HAPTIC is not set

# Camera
CONFIG_TECHPACK_CAMERA_XIAOMI=y

# =============================================================================
# 双系统统一适配（AOSP + MIUI/HyperOS）——配置级适配，固化在源码内
#
# 本文件是 defconfig fragment：make 时在 munch_defconfig 之后合并，优先级更高。
# 所以这里写的开关就是最终 out/.config 的值，不依赖 CI 里临时 scripts/config -e/-d。
#
# 取值依据：
#   1) 原厂实跑 config —— 从 munch 原厂 boot.img 内嵌 IKCONFIG 提取（CONFIG_IKCONFIG=y）
#   2) ki 内核（同 sm8250 / 4.19.325，已实测能开机日用）的最终 .config
#
# 注意：ki 内核里那批小米私有开关（XIAOMI_MIUI / MILLET / MIGT / SF_BINDER /
# MI_RECLAIM / BOOTUP_RECLAIM / RTMM）是那棵树自带的 Kconfig 符号，
# 本树（fmxr044 lineage 底座）里**不存在**这些符号，写进来会被 kconfig 直接丢弃，
# 所以不能靠照抄那几张表来"适配"。这里只落本树真实存在、且影响硬件通路的项。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. WLAN（munch = QCA6390 + 三天线）
#    本树把 qcacld 编译进内核（AOSP 侧没有 vendor 的 wlan.ko），
#    平台层 cnss2 必须带 QCA6390 支持，否则 probe 直接失败 → WiFi 完全不出。
# -----------------------------------------------------------------------------
CONFIG_CNSS2=y
CONFIG_CNSS_QCA6390=y
CONFIG_CNSS_UTILS=y
CONFIG_WCNSS_MEM_PRE_ALLOC=y
CONFIG_WIFI_THREE_ANTENNA=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"
CONFIG_CFG80211=y
CONFIG_RFKILL=y

# -----------------------------------------------------------------------------
# 2. 存储 / 加密（MIUI、HyperOS 的 /data 与 /metadata 依赖）
#    原厂 EXT4_ENCRYPTION=y、ECRYPT_FS=y；这棵树之前是关的。
#    /data 是 ext4 + fscrypt 时，关掉这两个会导致解密失败 → 起不来或卡开机。
# -----------------------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_ECRYPT_FS=y
CONFIG_KEYS=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y

# -----------------------------------------------------------------------------
# 3. 电量计 / 充电
#    munch 走 bq27z561 + smb5-munch，qcom 通用 FG 同时开会抢 /dev 与 power_supply
#    （ki 内核实测就是 n）。PD 策略只走 munch 自己那套。
# -----------------------------------------------------------------------------
# CONFIG_QPNP_FG_GEN4 is not set
CONFIG_FUEL_GAUGE_BQ27Z561_MUNCH=y
CONFIG_QPNP_SMB5_MUNCH=y
CONFIG_PD_POLICY_MANAGER_MUNCH=y

# -----------------------------------------------------------------------------
# 4. 触感 / 触控（munch 的 dts 是 compatible = "awinic,awinic_haptic"）
#
# 判断依据看的是驱动里的 of_match_table，不是芯片丝印：
#   aw8697_haptic/aw8697.c  → { .compatible = "awinic,aw8697_haptic" }
#   aw86927_haptic/aw_haptic.c → { .compatible = "awinic,awinic_haptic" }
# munch-sm8250.dtsi 里写的正是 "awinic,awinic_haptic"，所以只有 aw86927 能 probe。
#
# 两个驱动的 ringbuffer.c 都定义了 get_free_size/write_rb/grb 同名全局符号，
# 同时 =y 会在 vmlinux 链接阶段 duplicate symbol 报错，所以这里只保留 86927。
# -----------------------------------------------------------------------------
# CONFIG_INPUT_AW8697_HAPTIC is not set
CONFIG_INPUT_AW86927_HAPTIC=y
CONFIG_TOUCHSCREEN_FOCALTECH_3658U=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# -----------------------------------------------------------------------------
# 5. 显示兼容层
#    面板/背光走 techpack SDE + qcom wled，fbdev 兼容层保持原厂开启，
#    避免部分 vendor 服务（开机动画、充电界面）拿不到 fb0 直接黑屏。
# -----------------------------------------------------------------------------
CONFIG_FB=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y

# -----------------------------------------------------------------------------
# 6. ARM64 勘误处理（原厂全开；关掉在 kona 上会随机不稳、花屏、cache 不一致）
# -----------------------------------------------------------------------------
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1188873=y
CONFIG_ARM64_ERRATUM_1463225=y
CONFIG_ARM64_ERRATUM_1542418=y
CONFIG_ARM64_ERRATUM_1542419=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_845719=y

# -----------------------------------------------------------------------------
# 7. 模块加载（双系统关键：vendor .ko 的 vermagic 带 modversions）
# -----------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set

# -----------------------------------------------------------------------------
# 8. 无 LTO（原厂无 LTO；开 LTO 会让跨模块调用/符号版本行为变化）
# -----------------------------------------------------------------------------
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_THINLTO is not set
